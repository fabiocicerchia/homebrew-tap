        "scan-image",
        "verify-download"
      ],
      "mans": [
        "man/scan-image.1",
        "man/verify-download.1"
      ],
      "linux_only": true,
      "depends": [
        "syft",
        "grype",
        "trivy",
        "cosign"
      ],
      "test_binary": "scan-image",
      "caveats": "verify-download uses GNU sha256sum, which is why this is Linux-only.",
      "help_flag": false
    },
