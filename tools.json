{
  "_comment": [
    "Every formula in this tap is generated from this file by scripts/render_formulae.py.",
    "Add a tool here, not a .rb by hand \u2014 the renderer overwrites Formula/.",
    "A tool whose latest release does not yet carry the files listed here is",
    "skipped with a note, and picked up on the next run once it releases."
  ],
  "tools": [
    {
      "formula": "chaosbox",
      "repo": "chaos-toolbox",
      "kind": "shell",
      "desc": "Small, time-boxed chaos experiments",
      "license": "Apache-2.0",
      "binaries": [
        "chaosbox"
      ],
      "mans": [
        "man/chaosbox.1"
      ],
      "linux_only": true,
      "depends": [
        "stress-ng"
      ],
      "caveats": "Network experiments need tc (iproute2) and CAP_NET_ADMIN.\n`chaosbox kill` needs docker or kubectl, depending on --mode.",
      "help_flag": true
    },
    {
      "formula": "netreport",
      "repo": "mtr-toolbox",
      "kind": "shell",
      "desc": "One-shot connectivity snapshot for incident notes",
      "license": "Apache-2.0",
      "binaries": [
        "netreport"
      ],
      "mans": [
        "man/netreport.1"
      ],
      "linux_only": true,
      "depends": [
        "mtr"
      ],
      "caveats": "Uses ip(8) from iproute2 and dig(1); both are expected on the host.",
      "help_flag": false
    },
    {
      "formula": "cluster-collect",
      "repo": "cluster-info-collector",
      "kind": "shell",
      "desc": "Gather a Kubernetes incident support bundle",
      "license": "Apache-2.0",
      "binaries": [
        "cluster-collect"
      ],
      "mans": [
        "man/cluster-collect.1"
      ],
      "depends": [
        "kubernetes-cli"
      ],
      "extra_files": {
        "lib.sh": "lib/cluster-info-collector"
      },
      "caveats": "Set BUNDLE_S3_URI to upload the bundle; that path needs the AWS CLI.",
      "help_flag": false
    },
    {
      "formula": "init-toolkit",
      "repo": "init-toolkit",
      "kind": "shell",
      "desc": "Readiness and health-check probes for init containers",
      "license": "Apache-2.0",
      "binaries": [
        "bin/wait-for",
        "bin/healthcheck-http",
        "bin/healthcheck-tcp"
      ],
      "mans": [
        "man/wait-for.1",
        "man/healthcheck-http.1",
        "man/healthcheck-tcp.1"
      ],
      "test_binary": "wait-for",
      "help_flag": true
